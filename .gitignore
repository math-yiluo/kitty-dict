# Dependencies
node_modules/

# SvelteKit / Vite build outputs
.svelte-kit/
build/

# Capacitor sync targets (regenerated by `npx cap sync`)
android/app/src/main/assets/public/
ios/App/App/public/

# Symlinks/junctions to data/*-mp3 — platform-specific, regenerate via
#   node scripts/setup-static-audio.cjs
static/audio/

# Android build outputs & local config (keep source code; ignore artifacts)
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/captures/
android/.externalNativeBuild/
android/.cxx/

# iOS build outputs & dependencies
ios/App/build/
ios/App/Pods/
ios/DerivedData/
ios/.idea/

# Release signing keystores — NEVER commit
*.jks
*.keystore
*.pem
*.p12

# Env / secrets / local overrides
.env
.env.*
!.env.example
*.local

# Python bytecode cache (from scripts/*.py, e.g. build_db.py / migrations)
__pycache__/
*.pyc

# Vite's transient TS-config transpile artifacts (auto-generated, sometimes
# left behind if a dev/build process is interrupted)
vite.config.ts.timestamp-*.mjs
vite.config.js.timestamp-*.mjs

# Editor / OS junk
.DS_Store
desktop.ini
Thumbs.db
.vscode/
.idea/
*.iml

# Claude Code session state (per-machine, contains conversation context)
.claude/

# Personal dev notes (not for public release)
workflow.txt