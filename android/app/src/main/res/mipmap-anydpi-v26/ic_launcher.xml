<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon spec.

  @capacitor/assets by default wraps BOTH background and foreground in
  <inset android:inset="16.7%" />, which restricts the drawable to the
  inner 66.6% of the icon canvas. That leaves the outer 16.7% of the
  canvas transparent. Many Android launchers use square / squircle masks
  that expose more than the inner 66.6% — the user then sees the
  inner-yellow vs. outer-transparent boundary as a faint "border line"
  around the icon (reported as two faint vertical lines that look like
  a border frame).

  Fix: drop the inset on BACKGROUND so the yellow drawable fills the
  whole canvas — no transparent ring, no visible boundary. Keep the inset
  on FOREGROUND so the cat content stays inside the inner 66.6% safe
  zone where every launcher mask is guaranteed to show it without
  cropping ears or the graduation cap.

  NOTE: this file is regenerated by `npx capacitor-assets generate`. If
  you re-run that, you'll need to re-apply this fix (or fix it in
  capacitor-assets's template).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground>
        <inset android:drawable="@mipmap/ic_launcher_foreground" android:inset="16.7%" />
    </foreground>
</adaptive-icon>
